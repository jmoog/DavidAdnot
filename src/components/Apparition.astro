---
// Fait apparaître en fondu les éléments [data-apparition] au défilement.
---
<script>
  const els = document.querySelectorAll<HTMLElement>('[data-apparition]');
  if ('IntersectionObserver' in window && els.length) {
    const io = new IntersectionObserver((entrees) => {
      entrees.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('apparu'); io.unobserve(e.target); }
      });
    }, { rootMargin: '0px 0px -8% 0px' });
    els.forEach((el) => { el.classList.add('apparition-prete'); io.observe(el); });
  }
</script>
