---
// Bandeau de consentement cookies — inspiré de celui de l'Entrepôt du Matelas.
// Deux petits cookies se promènent sur le bandeau (l'un avec un casque de chantier
// et un marteau, l'autre avec un béret et un drapeau français) ; ils sautent de joie
// si l'on accepte, font la tête si l'on refuse.
// Choix mémorisé en localStorage ('adnot-consent' = 'granted' | 'denied'), clé lue
// par BaseLayout.astro pour réappliquer le Consent Mode GA4 à chaque visite.
// Bandeau et pastille disparaissent après 800 px de défilement.
// Rouvrir le bandeau : pastille flottante ou tout lien vers #cookies-reglages.

const svg = `<svg class="ack-svg" viewBox="0 0 160 124" aria-hidden="true" focusable="false">
<g class="ack-c ack-c--b">
  <g class="ack-leg ack-leg--1" style="transform-origin:32px 96px"><path d="M32 96v14.5" fill="none" stroke="#3a2214" stroke-width="4" stroke-linecap="round"/><ellipse cx="35" cy="112.8" rx="6.5" ry="3.8" fill="#1a5aa6"/></g>
  <g class="ack-leg ack-leg--2" style="transform-origin:48px 96px"><path d="M48 96v14.5" fill="none" stroke="#3a2214" stroke-width="4" stroke-linecap="round"/><ellipse cx="51" cy="112.8" rx="6.5" ry="3.8" fill="#1a5aa6"/></g>
  <g class="ack-body" style="transform-origin:40px 72px"><g transform="translate(6.4 38.4) scale(.56)">
    <g transform="rotate(-26 6 70)">
      <rect x="1" y="30" width="9" height="90" rx="4.5" fill="#9a6532"/>
      <rect x="3" y="34" width="3" height="80" rx="1.5" fill="#bd8549"/>
      <path d="M-16 20h30a4 4 0 0 1 4 4v8a4 4 0 0 1-4 4h-30q-6-8 0-16z" fill="#5b6673"/>
      <path d="M18 22q12 2 16 12" fill="none" stroke="#5b6673" stroke-width="6" stroke-linecap="round"/>
    </g>
    <circle cx="60" cy="62" r="52" fill="#b06a2c"/><circle cx="60" cy="60" r="50" fill="#d99a52"/><circle cx="60" cy="58" r="44" fill="#e8b46e" opacity=".55"/>
    <g fill="#4a2a16"><path d="M22 62c3-3 8-2 8 2s-3 7-7 6-4-5-1-8z"/><path d="M84 88c4-2 9 0 8 4s-5 6-9 5-3-7 1-9z"/><path d="M46 96c3-2 7 0 7 3s-4 5-7 4-3-5 0-7z"/><path d="M96 58c3-2 6 0 6 3s-3 5-6 4-2-5 0-7z"/></g>
    <circle cx="36" cy="74" r="6" fill="#ef7f5f" opacity=".5"/><circle cx="84" cy="74" r="6" fill="#ef7f5f" opacity=".5"/>
    <g class="ack-eyes"><ellipse cx="47" cy="58" rx="6.5" ry="8" fill="#fff"/><ellipse cx="73" cy="58" rx="6.5" ry="8" fill="#fff"/><circle cx="49" cy="59" r="3.4" fill="#2a160c"/><circle cx="75" cy="59" r="3.4" fill="#2a160c"/></g>
    <path class="ack-smile" d="M51 74q9 9 18 0" fill="none" stroke="#3a2214" stroke-width="4" stroke-linecap="round"/><path class="ack-smile-open" d="M49 72q11 16 22 0z" fill="#3a2214"/><path class="ack-sad" d="M52 80q8-7 16 0" fill="none" stroke="#3a2214" stroke-width="4" stroke-linecap="round"/>
    <g>
      <path d="M14 24a46 40 0 0 1 92 0z" fill="#b73337"/>
      <path d="M60 -16v38" stroke="#d24c50" stroke-width="10" stroke-linecap="round"/>
      <path d="M30 6q8-12 20-16" fill="none" stroke="#e27a7d" stroke-width="3.5" stroke-linecap="round" opacity=".8"/>
      <rect x="4" y="19" width="112" height="9" rx="4.5" fill="#922629"/>
    </g>
  </g></g>
</g>
<g class="ack-c ack-c--a">
  <g class="ack-leg ack-leg--1" style="transform-origin:100px 90px"><path d="M100 90v20" fill="none" stroke="#3a2214" stroke-width="5" stroke-linecap="round"/><ellipse cx="104" cy="112.5" rx="8.5" ry="4.5" fill="#b73337"/></g>
  <g class="ack-leg ack-leg--2" style="transform-origin:124px 90px"><path d="M124 90v20" fill="none" stroke="#3a2214" stroke-width="5" stroke-linecap="round"/><ellipse cx="128" cy="112.5" rx="8.5" ry="4.5" fill="#b73337"/></g>
  <g class="ack-body" style="transform-origin:112px 56px"><g transform="translate(65.8 9.8) scale(.77)">
    <path d="M16 94L3 -40" fill="none" stroke="#7a5230" stroke-width="4.5" stroke-linecap="round"/><circle cx="3" cy="-42" r="4" fill="#ffd23f"/>
    <g class="ack-flag"><rect x="-11" y="-38" width="13" height="26" fill="#0055a4"/><rect x="-24" y="-38" width="13" height="26" fill="#fff"/><rect x="-37" y="-38" width="13" height="26" fill="#ef4135"/></g>
    <circle cx="60" cy="62" r="52" fill="#a9652a"/><circle cx="60" cy="60" r="50" fill="#dca05a"/><circle cx="60" cy="58" r="44" fill="#ebb873" opacity=".55"/>
    <g fill="#4a2a16"><path d="M20 64c3-3 8-2 8 2s-3 7-7 6-4-5-1-8z"/><path d="M88 86c4-2 9 0 8 4s-5 6-9 5-3-7 1-9z"/><path d="M44 94c3-2 7 0 7 3s-4 5-7 4-3-5 0-7z"/><path d="M97 54c3-2 6 0 6 3s-3 5-6 4-2-5 0-7z"/><path d="M66 88c3-2 6 0 6 3s-3 5-6 4-3-5 0-7z"/></g>
    <circle cx="14" cy="88" r="7" fill="#c27f3f"/>
    <circle cx="37" cy="72" r="6" fill="#ef7f5f" opacity=".45"/><circle cx="83" cy="72" r="6" fill="#ef7f5f" opacity=".45"/>
    <g class="ack-eyes" fill="#3a2214"><ellipse cx="47" cy="56" rx="5" ry="6.5"/><ellipse cx="73" cy="56" rx="5" ry="6.5"/><circle cx="48.8" cy="53.5" r="1.8" fill="#fff"/><circle cx="74.8" cy="53.5" r="1.8" fill="#fff"/></g>
    <path class="ack-smile" d="M51 72q9 9 18 0" fill="none" stroke="#3a2214" stroke-width="3.5" stroke-linecap="round"/><path class="ack-smile-open" d="M49 70q11 16 22 0z" fill="#3a2214"/><path class="ack-sad" d="M52 78q8-7 16 0" fill="none" stroke="#3a2214" stroke-width="3.5" stroke-linecap="round"/>
    <g transform="rotate(-12 60 14)"><ellipse cx="60" cy="16" rx="50" ry="15" fill="#0e2f52"/><ellipse cx="60" cy="11" rx="43" ry="11" fill="#1a5aa6"/><path d="M60 0q2-8 8-11" fill="none" stroke="#0e2f52" stroke-width="5" stroke-linecap="round"/></g>
  </g></g>
</g>
</svg>`;

const miettes = Array.from({ length: 12 }, (_, f) => {
  const taille = 2 + ((f * 7) % 3);
  return `left:${(f * 37) % 100}%;width:${taille}px;height:${taille}px;animation-duration:${8 + ((f * 3) % 6)}s;animation-delay:-${((f * 1.3) % 8).toFixed(1)}s`;
});
---
<div class="ack" id="ack" role="dialog" aria-modal="false" aria-labelledby="ack-titre" aria-describedby="ack-texte" hidden>
  <div class="ack-miettes" aria-hidden="true">
    {miettes.map((style) => <i style={style}></i>)}
  </div>
  <div class="ack-promenade" aria-hidden="true">
    <div class="ack-duo"><span class="ack-retourne" set:html={svg} /></div>
  </div>
  <div class="ack-contenu">
    <p class="ack-titre" id="ack-titre">Deux petits cookies <span>fabriqués en France ?</span></p>
    <p class="ack-texte" id="ack-texte">
      Comme une toiture, ils sont posés avec soin. Avec votre accord, nous mesurons simplement
      la fréquentation du site avec Google Analytics. Vous pouvez changer d’avis à tout moment.
      <a href="/politique-de-confidentialite/">En savoir plus</a>
    </p>
    <div class="ack-actions">
      <button type="button" class="ack-btn" data-ack="refuse">Tout refuser</button>
      <button type="button" class="ack-btn" data-ack="accepte">Tout accepter</button>
    </div>
  </div>
</div>
<button type="button" class="ack-pastille" id="ack-pastille" aria-label="Gérer mes cookies" title="Gérer mes cookies" hidden set:html={svg} />

<style is:global>
  .ack {
    position: fixed;
    left: 24px;
    bottom: 24px;
    z-index: 90;
    width: min(430px, calc(100vw - 32px));
    box-sizing: border-box;
    background: var(--blanc);
    color: var(--gris-700);
    border: 1px solid var(--gris-200);
    border-radius: 14px;
    box-shadow: 0 18px 50px rgba(14, 47, 82, 0.28);
    padding: 20px 22px 18px;
    font-family: var(--font);
    font-size: 15px;
    line-height: 1.55;
    text-align: left;
    transform: translateY(0);
    opacity: 1;
    transition: transform 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.2), opacity 0.4s ease, bottom 0.45s ease;
  }
  .ack[hidden], .ack-pastille[hidden] { display: none !important; }
  .ack.est-entrant { transform: translateY(40px); opacity: 0; }
  .ack.est-sortant { transform: translateY(40px) scale(0.96); opacity: 0; }

  .ack-miettes { position: absolute; inset: 0; border-radius: 14px; overflow: hidden; pointer-events: none; }
  .ack-miettes i {
    position: absolute; top: -10px; display: block; border-radius: 40%;
    background: #d99a52; opacity: 0.28; animation: ack-miette linear infinite;
  }

  .ack-contenu { position: relative; }
  .ack-titre { margin: 0 0 8px; font-size: 19px; font-weight: 700; color: var(--bleu-fonce); line-height: 1.3; }
  .ack-titre span { color: var(--rouge); white-space: nowrap; }
  .ack-texte { margin: 0 0 14px; color: var(--gris-700); }
  .ack-texte a { color: var(--bleu); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; white-space: nowrap; }

  .ack-actions { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 10px; }
  .ack-btn {
    appearance: none; border: 0; cursor: pointer; width: auto;
    font: inherit; font-weight: 700; font-size: 15px; line-height: 1;
    padding: 13px 20px; border-radius: 8px;
    background: var(--bleu); color: var(--blanc);
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .ack-btn:hover { background: var(--bleu-fonce); transform: translateY(-1px); }
  .ack-btn:focus-visible, .ack-pastille:focus-visible { outline: 3px solid var(--rouge); outline-offset: 2px; }

  /* Les deux cookies qui se promènent sur le bord haut du bandeau */
  .ack-promenade { position: absolute; left: 14px; right: 14px; bottom: 100%; height: 80px; margin-bottom: -6px; pointer-events: none; }
  .ack-duo { position: absolute; left: 0; bottom: 0; width: 104px; height: 80px; animation: ack-marche 16s linear infinite; }
  .ack-retourne { display: block; width: 100%; height: 100%; animation: ack-demi-tour 16s step-end infinite; }
  .ack-svg { display: block; width: 100%; height: 100%; overflow: visible; }

  .ack-duo .ack-leg, .ack-pastille:hover .ack-leg { animation: ack-pas 0.46s ease-in-out infinite alternate; }
  .ack-duo .ack-leg--2, .ack-pastille:hover .ack-leg--2 { animation-delay: -0.46s; }
  .ack-duo .ack-c--b .ack-leg, .ack-pastille:hover .ack-c--b .ack-leg { animation-duration: 0.36s; }
  .ack-duo .ack-c--b .ack-leg--2, .ack-pastille:hover .ack-c--b .ack-leg--2 { animation-delay: -0.36s; }
  .ack-duo .ack-body, .ack-pastille:hover .ack-body { animation: ack-balance 0.23s ease-in-out infinite alternate; }
  .ack-duo .ack-c--b .ack-body, .ack-pastille:hover .ack-c--b .ack-body { animation-duration: 0.18s; }
  .ack-svg .ack-eyes { transform-box: fill-box; transform-origin: center; animation: ack-clin 4.5s infinite; }
  .ack-svg .ack-c--b .ack-eyes { animation-delay: -1.7s; }
  .ack-svg .ack-flag { transform-box: fill-box; transform-origin: 100% 50%; animation: ack-drapeau 1.1s ease-in-out infinite alternate; }
  .ack-svg .ack-smile-open, .ack-svg .ack-sad { opacity: 0; }

  /* Réactions : joie si on accepte, mine boudeuse si on refuse */
  .ack.est-content .ack-duo, .ack.est-content .ack-retourne,
  .ack.est-triste .ack-duo, .ack.est-triste .ack-retourne { animation-play-state: paused; }
  .ack.est-content .ack-svg { animation: ack-saut 0.6s ease-out; }
  .ack.est-content .ack-flag { animation-duration: 0.35s; }
  .ack.est-content .ack-smile { opacity: 0; }
  .ack.est-content .ack-smile-open { opacity: 1; }
  .ack.est-triste .ack-leg, .ack.est-triste .ack-body { animation: none; }
  .ack.est-triste .ack-body { transform: translateY(3px); }
  .ack.est-triste .ack-smile { opacity: 0; }
  .ack.est-triste .ack-sad { opacity: 1; }
  .ack.est-triste .ack-eyes { animation: none; transform: translateY(2px) scaleY(0.7); }
  .ack.est-triste .ack-flag { animation: none; transform: rotate(-18deg) skewY(8deg); }

  /* Pastille pour rouvrir le bandeau */
  .ack-pastille {
    position: fixed; left: 16px; bottom: 16px; z-index: 89;
    width: 58px; height: 58px; padding: 9px 5px 5px;
    border: 1px solid var(--gris-200); border-radius: 50%;
    background: var(--blanc); box-shadow: 0 4px 16px rgba(14, 47, 82, 0.18);
    cursor: pointer; transition: transform 0.25s ease, bottom 0.45s ease;
  }
  .ack-pastille:hover { transform: scale(1.08); }

  @keyframes ack-marche { 0% { left: 0; } 47% { left: calc(100% - 104px); } 50% { left: calc(100% - 104px); } 97% { left: 0; } 100% { left: 0; } }
  @keyframes ack-marche-m { 0% { left: 0; } 47% { left: calc(100% - 84px); } 50% { left: calc(100% - 84px); } 97% { left: 0; } 100% { left: 0; } }
  @keyframes ack-demi-tour { 0% { transform: scaleX(1); } 48.5% { transform: scaleX(-1); } 98.5% { transform: scaleX(1); } }
  @keyframes ack-pas { from { transform: rotate(-24deg); } to { transform: rotate(24deg); } }
  @keyframes ack-balance { from { transform: translateY(0) rotate(2deg); } to { transform: translateY(-3px) rotate(5deg); } }
  @keyframes ack-clin { 0%, 92%, 100% { transform: scaleY(1); } 95% { transform: scaleY(0.1); } }
  @keyframes ack-drapeau { from { transform: skewY(-7deg) scaleX(0.94); } to { transform: skewY(5deg) scaleX(1); } }
  @keyframes ack-saut { 0% { transform: translateY(0); } 30% { transform: translateY(-16px) rotate(-5deg); } 55% { transform: translateY(0); } 75% { transform: translateY(-8px) rotate(4deg); } 100% { transform: translateY(0); } }
  @keyframes ack-miette { 0% { transform: translate(0, 0) rotate(0); } 50% { transform: translate(6px, 110px) rotate(120deg); } 100% { transform: translate(-4px, 230px) rotate(240deg); } }

  @media (max-width: 800px) {
    .ack {
      left: 12px; right: 12px; width: auto;
      bottom: calc(12px + env(safe-area-inset-bottom));
      padding: 14px 16px; font-size: 14px; line-height: 1.5;
    }
    .ack-titre { font-size: 17px; margin-bottom: 6px; }
    .ack-texte { margin-bottom: 12px; }
    .ack-actions { gap: 8px; }
    .ack-btn { min-height: 48px; padding: 0 18px; display: inline-flex; align-items: center; justify-content: center; }
    .ack-promenade { height: 65px; margin-bottom: -5px; }
    .ack-duo { width: 84px; height: 65px; animation-name: ack-marche-m; }
    .ack-pastille { bottom: calc(16px + env(safe-area-inset-bottom)); width: 54px; height: 54px; }
    /* La barre Appeler / WhatsApp / Devis est visible : on remonte au-dessus */
    body:has(.contact-flottant--visible) .ack { bottom: calc(68px + env(safe-area-inset-bottom)); }
    body:has(.contact-flottant--visible) .ack-pastille { bottom: calc(72px + env(safe-area-inset-bottom)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ack, .ack *, .ack-pastille, .ack-pastille * { animation: none !important; transition: none !important; }
  }
</style>

<script>
  const CLE = 'adnot-consent';
  const SEUIL = 800; // bandeau et pastille disparaissent après 800 px de défilement
  const OUVRIR = 'a[href$="#cookies-reglages"]';

  const boite = document.getElementById('ack') as HTMLElement | null;
  const pastille = document.getElementById('ack-pastille') as HTMLElement | null;

  function lire(): string | null {
    try { return localStorage.getItem(CLE); } catch (e) { return null; }
  }
  function ecrire(valeur: string) {
    try { localStorage.setItem(CLE, valeur); } catch (e) {}
  }
  function propager(valeur: string) {
    const w = window as any;
    if (typeof w.gtag === 'function') w.gtag('consent', 'update', { analytics_storage: valeur });
  }
  function effacerCookiesGA() {
    const hote = location.hostname;
    const parts = hote.split('.');
    const domaines = ['', hote, '.' + hote];
    if (parts.length > 2) domaines.push('.' + parts.slice(-2).join('.'));
    document.cookie.split(';').forEach((c) => {
      const nom = c.split('=')[0].trim();
      if (/^(_ga|_ga_.*|_gid|_gat.*)$/.test(nom)) {
        domaines.forEach((d) => { document.cookie = nom + '=;path=/;max-age=0' + (d ? ';domain=' + d : ''); });
      }
    });
  }

  if (boite && pastille) {
    const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let enSortie = false;
    let enAttente = false;
    let force = false;
    const auDela = () => (window.scrollY || document.documentElement.scrollTop || 0) >= SEUIL;

    const montrer = (parUtilisateur: boolean) => {
      boite.classList.remove('est-content', 'est-triste', 'est-sortant');
      boite.classList.add('est-entrant');
      boite.hidden = false;
      pastille.hidden = true;
      requestAnimationFrame(() => requestAnimationFrame(() => boite.classList.remove('est-entrant')));
      if (parUtilisateur) (boite.querySelector('[data-ack="refuse"]') as HTMLElement | null)?.focus({ preventScroll: true });
    };
    const cacher = () => {
      boite.classList.add('est-sortant');
      setTimeout(() => {
        boite.hidden = true;
        boite.classList.remove('est-sortant');
        pastille.hidden = auDela();
      }, reduit ? 0 : 400);
    };
    const decider = (accepte: boolean) => {
      const avant = lire();
      const valeur = accepte ? 'granted' : 'denied';
      ecrire(valeur);
      propager(valeur);
      if (accepte) {
        boite.classList.add('est-content');
      } else {
        effacerCookiesGA();
        boite.classList.add('est-triste');
        // GA déjà chargé avec l'accord : on recharge pour l'arrêter proprement
        if (avant === 'granted') { setTimeout(() => location.reload(), reduit ? 0 : 800); return; }
      }
      setTimeout(cacher, reduit ? 0 : 800);
    };

    boite.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('[data-ack]');
      if (b) decider(b.getAttribute('data-ack') === 'accepte');
    });
    pastille.addEventListener('click', () => { force = true; montrer(true); });
    document.addEventListener('click', (e) => {
      const lien = (e.target as HTMLElement).closest(OUVRIR);
      if (lien) { e.preventDefault(); force = true; montrer(true); }
    });

    const auDefilement = () => {
      if (auDela()) {
        if (!boite.hidden) {
          if (force || enSortie) return;
          enSortie = true;
          cacher();
          setTimeout(() => { enSortie = false; pastille.hidden = true; }, reduit ? 10 : 450);
        } else {
          force = false;
          if (!enSortie && !enAttente) pastille.hidden = true;
        }
      } else if (!enSortie && !enAttente && boite.hidden) {
        pastille.hidden = false;
      }
    };
    window.addEventListener('scroll', auDefilement, { passive: true });

    if (!lire()) {
      enAttente = true;
      setTimeout(() => {
        enAttente = false;
        if (auDela()) pastille.hidden = true;
        else montrer(false);
      }, 600);
    } else {
      pastille.hidden = auDela();
    }
  }
</script>
