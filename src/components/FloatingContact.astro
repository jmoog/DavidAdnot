---
// Barre de contact fixe en bas d'écran sur mobile : appel, WhatsApp, devis.
// Sur desktop, les CTA du header suffisent — la barre est masquée.
---
<div class="contact-flottant" role="complementary" aria-label="Contact rapide">
  <a href="tel:0660491430" class="contact-flottant__btn contact-flottant__btn--appel">
    <svg class="icone" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M6.9 4A2.6 2.6 0 0 0 4.3 6.6v12.8A2.6 2.6 0 0 0 6.9 22h5.2a2.6 2.6 0 0 0 2.6-2.6V6.6A2.6 2.6 0 0 0 12.1 4H6.9Zm1.3 2.1a.75.75 0 0 0 0 1.5h2.6a.75.75 0 0 0 0-1.5H8.2Zm1.3 13.5a1.05 1.05 0 1 0 0-2.1 1.05 1.05 0 0 0 0 2.1Z"/><path stroke="currentColor" stroke-width="1.7" stroke-linecap="round" d="M17.2 8.2a4.6 4.6 0 0 1 2.2 2.8M18.4 4.8a8.2 8.2 0 0 1 3.8 4.9"/></svg>
    Appeler
  </a>
  <a href="https://wa.me/33660491430" class="contact-flottant__btn contact-flottant__btn--whatsapp" rel="noopener" target="_blank">
    <svg class="icone" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.9-1.4A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.2 1.2-1.7 1.2-.4.1-1 .1-1.6-.1a13 13 0 0 1-1.5-.5 11.5 11.5 0 0 1-4.4-3.9 5 5 0 0 1-1-2.7c0-1.3.7-1.9 1-2.2.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.4l.9 2.1c0 .2.1.3 0 .5l-.3.5-.5.5c-.1.2-.3.3-.1.6.2.4.8 1.4 1.8 2.2 1.2 1.1 2.2 1.4 2.6 1.6.3.1.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.3 0 .1 0 .7-.2 1.2z"/></svg>
    WhatsApp
  </a>
  <a href="/contact/" class="contact-flottant__btn contact-flottant__btn--devis">
    <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.6"/><path d="M8.2 12h7M12.7 8.9 15.8 12l-3.1 3.1"/></svg>
    Devis gratuit
  </a>
</div>

<style>
  .contact-flottant {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 60;
    display: none;
    grid-template-columns: 1fr 1fr 1.3fr;
    box-shadow: 0 -4px 16px rgba(0, 41, 58, 0.18);
    transform: translateY(110%);
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }
  /* Visible seulement après 450 px de scroll (géré par le script) */
  .contact-flottant--visible { transform: translateY(0); }
  .contact-flottant__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45em;
    padding: 0.9em 0.5em;
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    color: var(--blanc);
  }
  .contact-flottant__btn:hover { color: var(--blanc); }
  .contact-flottant__btn--appel { background: var(--bleu); }
  .contact-flottant__btn--whatsapp { background: #1faa54; }
  .contact-flottant__btn--devis { background: var(--rouge); }

  @media (max-width: 800px) {
    .contact-flottant { display: grid; }
    /* Réserve la hauteur de la barre pour ne pas tronquer le bas de page,
       en respectant la zone sécurisée des iPhone (safe-area) */
    :global(body) { padding-bottom: calc(56px + env(safe-area-inset-bottom)); }
    .contact-flottant { padding-bottom: env(safe-area-inset-bottom); }
  }
</style>

<script>
  // La barre apparaît après 450 px de scroll, et libère le bas de page sinon
  const barre = document.querySelector('.contact-flottant');
  let tickCF = false;
  window.addEventListener('scroll', () => {
    if (tickCF) return;
    tickCF = true;
    requestAnimationFrame(() => {
      barre?.classList.toggle('contact-flottant--visible', window.scrollY > 450);
      tickCF = false;
    });
  }, { passive: true });
</script>
