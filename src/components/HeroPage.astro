---
// Hero réutilisable des pages services / villes : colonne texte + colonne média.
// Le contenu libre (accroche, listes) passe par le slot par défaut.
import FilAriane from './FilAriane.astro';
import reviews from '../data/reviews.json';

export interface Props {
  h1: string;
  image: string;
  imageAlt: string;
  /** Libellé de la page dans le fil d'Ariane */
  ariane: string;
}
const { h1, image, imageAlt, ariane } = Astro.props;
---
<section class="hero">
  <div class="conteneur">
    <FilAriane items={[{ label: 'Accueil', href: '/' }, { label: ariane }]} />
  </div>
  <div class="conteneur hero__grille">
    <div class="hero__texte">
      <h1>{h1}</h1>
      <p class="hero__google">
        <span class="hero__etoiles" aria-hidden="true">★★★★★</span>
        <strong>{reviews.note.toLocaleString('fr-FR')}/5 sur Google · {reviews.nombre} avis</strong>
      </p>
      <slot />
      <div class="hero__actions">
        <a href="tel:0660491430" class="btn btn--rouge">
          <svg class="icone" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.25 1z"/></svg>
          06 60 49 14 30
        </a>
        <a href="/contact/" class="btn btn--bleu">Devis Gratuit →</a>
      </div>
    </div>

    <div class="hero__media">
      <img
        class="hero__photo"
        src={image}
        alt={imageAlt}
        fetchpriority="high"
        width="1200"
        height="900"
      />
      <div class="carte hero__garantie">
        <span class="hero__garantie-icone" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5z"/><path d="M8.5 12l2.5 2.5L16 9.5"/></svg>
        </span>
        <p><strong>Garantie Décennale</strong><br />Pour tous travaux de couverture</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero__garantie-icone {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--rouge-pale);
    color: var(--rouge);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .hero__garantie-icone svg { width: 2.1rem; height: 2.1rem; }
</style>
