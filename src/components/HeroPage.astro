---
// Hero réutilisable des pages services / villes : colonne texte + colonne média.
// Le contenu libre (accroche, listes) passe par le slot par défaut.
import FilAriane from './FilAriane.astro';
import reviews from '../data/reviews.json';

export interface Props {
  h1: string;
  image: string;
  imageAlt: string;
  /** Libellé de la page dans le fil d'Ariane */
  ariane: string;
}
const { h1, image, imageAlt, ariane } = Astro.props;
---
<section class="hero">
  <div class="conteneur">
    <FilAriane items={[{ label: 'Accueil', href: '/' }, { label: ariane }]} />
  </div>
  <div class="conteneur hero__grille">
    <div class="hero__texte">
      <h1>{h1}</h1>
      <p class="hero__google">
        <span class="hero__etoiles" aria-hidden="true">★★★★★</span>
        <strong>{reviews.note.toLocaleString('fr-FR')}/5 sur Google · {reviews.nombre} avis</strong>
      </p>
      <slot />
      <div class="hero__actions">
        <a href="tel:0660491430" class="btn btn--rouge">
          <svg class="icone" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M6.9 4A2.6 2.6 0 0 0 4.3 6.6v12.8A2.6 2.6 0 0 0 6.9 22h5.2a2.6 2.6 0 0 0 2.6-2.6V6.6A2.6 2.6 0 0 0 12.1 4H6.9Zm1.3 2.1a.75.75 0 0 0 0 1.5h2.6a.75.75 0 0 0 0-1.5H8.2Zm1.3 13.5a1.05 1.05 0 1 0 0-2.1 1.05 1.05 0 0 0 0 2.1Z"/><path stroke="currentColor" stroke-width="1.7" stroke-linecap="round" d="M17.2 8.2a4.6 4.6 0 0 1 2.2 2.8M18.4 4.8a8.2 8.2 0 0 1 3.8 4.9"/></svg>
          06 60 49 14 30
        </a>
        <a href="/contact/" class="btn btn--bleu">Devis Gratuit <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.6"/><path d="M8.2 12h7M12.7 8.9 15.8 12l-3.1 3.1"/></svg></a>
      </div>
    </div>

    <div class="hero__media">
      <img
        class="hero__photo"
        src={image}
        alt={imageAlt}
        fetchpriority="high"
        width="1200"
        height="900"
      />
      <div class="carte hero__garantie">
        <span class="hero__garantie-icone" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5z"/><path d="M8.5 12l2.5 2.5L16 9.5"/></svg>
        </span>
        <p><strong>Garantie Décennale</strong><br />Pour tous travaux de couverture</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero__garantie-icone {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--rouge-pale);
    color: var(--rouge);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .hero__garantie-icone svg { width: 2.1rem; height: 2.1rem; }
</style>
