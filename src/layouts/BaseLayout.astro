---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingContact from '../components/FloatingContact.astro';
import CookieBanner from '../components/CookieBanner.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  /** Schémas JSON-LD additionnels propres à la page (BreadcrumbList, Service…) */
  extraSchemas?: object[];
}

const {
  title,
  description,
  canonical,
  ogImage = '/images/logo-david-adnot-artisan-couvreur.webp',
  noindex = false,
  extraSchemas = [],
} = Astro.props;
const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).toString();
---
<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.webp" type="image/webp" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Montserrat auto-hébergée : @font-face + WOFF2 servis depuis le domaine,
         préchargement des variantes essentielles. Conforme RGPD. -->
    <Font cssVariable="--font-montserrat" preload />

    <!-- Google tag (gtag.js) — Consent Mode : mesure refusée par défaut,
         le choix mémorisé (bandeau cookies, clé 'adnot-consent') est réappliqué à chaque visite -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-1ZJPELCKN6"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied'
      });
      try {
        if (localStorage.getItem('adnot-consent') === 'granted') {
          gtag('consent', 'update', { analytics_storage: 'granted' });
        }
      } catch (e) {}
      gtag('js', new Date());
      gtag('config', 'G-1ZJPELCKN6');
    </script>

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="David Adnot — Artisan couvreur dans les Yvelines (78)" />

    <!-- Geo -->
    <meta name="geo.region" content="FR-78" />
    <meta name="geo.placename" content="Rambouillet, Yvelines" />

    <!-- Données structurées LocalBusiness (RoofingContractor) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "RoofingContractor",
      "@id": "https://www.adnot-couvreur.fr/#localbusiness",
      "name": "David Adnot — Artisan Couvreur",
      "alternateName": ["Adnot Couvreur", "Adnot Couvreur 78", "David Adnot Couvreur Rambouillet"],
      "description": description,
      "image": "https://www.adnot-couvreur.fr/images/logo-david-adnot-artisan-couvreur.webp",
      "logo": { "@type": "ImageObject", "url": "https://www.adnot-couvreur.fr/images/logo-david-adnot-artisan-couvreur.webp", "caption": "Logo David Adnot — Artisan couvreur dans les Yvelines" },
      "url": "https://www.adnot-couvreur.fr",
      "telephone": "+33660491430",
      "email": "contact@adnot-couvreur.fr",
      "founder": { "@type": "Person", "name": "David Adnot" },
      "priceRange": "€€",
      "currenciesAccepted": "EUR",
      "address": { "@type": "PostalAddress", "streetAddress": "Zone Industrielle le Pâtis, 4 Rue Paul Démange", "postalCode": "78120", "addressLocality": "Rambouillet", "addressRegion": "Île-de-France", "addressCountry": "FR" },
      "geo": { "@type": "GeoCoordinates", "latitude": 48.6522, "longitude": 1.8221 },
      "openingHoursSpecification": [
        { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"], "opens": "08:00", "closes": "19:00" }
      ],
      "areaServed": { "@type": "AdministrativeArea", "name": "Yvelines (78) — Rambouillet et sud Yvelines" },
      "knowsAbout": ["Couverture", "Zinguerie", "Réparation de toiture", "Rénovation de toiture", "Nettoyage et démoussage de toiture", "Traitement hydrofuge et anti-mousse", "Pose de fenêtres de toit Velux", "Isolation de toiture", "Pose et remplacement de gouttières", "Recherche de fuites"]
    })} />

    {extraSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <FloatingContact />
    <CookieBanner />
  </body>
</html>
