---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroPage from '../components/HeroPage.astro';
import AvisCarrousel from '../components/AvisCarrousel.astro';
import CtaDevis from '../components/CtaDevis.astro';

const title = 'Traitement de Toiture dans les Yvelines | Hydrofuge & Anti-Mousse';
const description = 'David Adnot : application de traitements hydrofuges et anti-mousse pour toitures dans les Yvelines. Protection durable professionnelle. Devis gratuit.';

const faq = [
  {
    q: "Quel est l'intérêt d'un traitement hydrofuge ?",
    r: "Le traitement hydrofuge imperméabilise les matériaux en faisant perler l'eau de pluie, qui glisse sans pénétrer. Cela prévient les dégâts dus au gel, à l'humidité stagnante et aux cycles de gel-dégel qui fragilisent les tuiles ou ardoises dans le temps.",
  },
  {
    q: 'Un traitement anti-mousse est-il vraiment utile ?',
    r: "Oui, surtout dans les Yvelines où l'humidité et la végétation favorisent la repousse rapide. Le traitement anti-mousse professionnel inhibe la germination des spores et ralentit significativement le retour des végétaux, espaçant ainsi la fréquence des nettoyages.",
  },
  {
    q: 'Peut-on appliquer un traitement sur une toiture neuve ?',
    r: "Absolument. Sur une toiture neuve, le traitement hydrofuge joue un rôle préventif en protégeant les matériaux dès leur pose. Il préserve leur couleur et leurs propriétés intactes plus longtemps.",
  },
  {
    q: "Combien de temps dure l'effet d'un traitement professionnel ?",
    r: "Un traitement appliqué dans les règles de l'art avec des produits professionnels offre une protection efficace entre 8 et 10 ans, selon l'exposition de la toiture aux intempéries et à la végétation.",
  },
  {
    q: "Doit-on nettoyer la toiture avant d'appliquer le traitement ?",
    r: "Oui, impérativement. Le traitement doit être appliqué sur une surface parfaitement propre et sèche pour adhérer correctement et garantir une efficacité optimale. Je peux bien sûr prendre en charge le nettoyage préalable.",
  },
];

const extraSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Application de traitement de toiture',
    serviceType: 'Traitement hydrofuge et anti-mousse de toiture',
    provider: { '@id': 'https://www.adnot-couvreur.fr/#localbusiness' },
    areaServed: { '@type': 'AdministrativeArea', name: 'Yvelines (78) — Rambouillet' },
    url: 'https://www.adnot-couvreur.fr/application-de-traitement-de-toiture-dans-les-yvelines-78/',
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.r },
    })),
  },
];
---
<BaseLayout title={title} description={description} extraSchemas={extraSchemas}>
  <HeroPage
    h1="Traitement de toiture dans les Yvelines (78)"
    image="/images/nettoyage/nettoyage-demoussage-toiture-yvelines-14.webp"
    imageAlt="Application d'un traitement hydrofuge sur une toiture en tuiles dans les Yvelines"
    ariane="Traitement de toiture"
  >
    <p class="hero__accroche">
      L'application d'un traitement de toiture permet de protéger durablement votre couverture
      après un <a href="/nettoyage-demoussage-toiture/">nettoyage</a>. Spécialiste des toitures
      en tuile et ardoise, j'interviens partout dans les Yvelines.
    </p>
    <ul>
      <li><strong>Traitements hydrofuges et anti-mousse professionnels</strong>, haute performance.</li>
      <li><strong>Imperméabilisation</strong> des matériaux : l'eau perle et s'écoule.</li>
      <li><strong>Repousse des végétaux freinée</strong> : moins d'entretien, un toit sain plus longtemps.</li>
    </ul>
  </HeroPage>

  <AvisCarrousel tag="nettoyage" ordre={3} />

  <!-- ── Pourquoi traiter ─────────────────────────────────────── -->
  <section class="section">
    <div class="conteneur duo">
      <div>
        <h2>Pourquoi appliquer un traitement de toiture ?</h2>
        <p>
          Un traitement de toiture n'est pas systématique, mais il constitue la protection la
          plus efficace pour prolonger durablement la durée de vie de votre couverture. Il
          renforce la résistance des matériaux aux agressions climatiques — pluie, gel, UV — et
          crée un environnement défavorable à la repousse des mousses, lichens et algues.
        </p>
        <p>
          C'est l'assurance de préserver l'étanchéité et l'esthétique de votre toiture pour de
          nombreuses années, en espaçant les nettoyages.
        </p>
      </div>
      <img
        src="/images/nettoyage/nettoyage-demoussage-toiture-yvelines-19.webp"
        alt="Toiture en tuiles protégée après traitement hydrofuge dans les Yvelines"
        loading="lazy"
        width="1200"
        height="900"
      />
    </div>
  </section>

  <!-- ── Les différents traitements ───────────────────────────── -->
  <section class="section section--bleute">
    <div class="conteneur">
      <h2>Les différents traitements de toiture et leurs applications</h2>
      <div class="etapes">
        <div class="etape">
          <span class="etape__numero">01</span>
          <h3>Le traitement hydrofuge incolore</h3>
          <p>
            Ce produit transparent pénètre en profondeur sans laisser de film en surface : l'eau
            de pluie perle et glisse sans pénétrer. Idéal pour les tuiles en terre cuite et les
            ardoises naturelles dont vous souhaitez préserver l'aspect authentique.
          </p>
        </div>
        <div class="etape">
          <span class="etape__numero">02</span>
          <h3>Le traitement hydrofuge anti-mousse</h3>
          <p>
            La formule la plus complète : une barrière contre l'eau et un effet répulsif contre
            la végétation. Recommandé pour les toitures très exposées à l'humidité ou entourées
            d'arbres — il réduit nettement la fréquence d'entretien.
          </p>
        </div>
        <div class="etape">
          <span class="etape__numero">03</span>
          <h3>Le traitement hydrofuge coloré</h3>
          <p>
            Des pigments ravivent la couleur d'origine, uniformisent la toiture et masquent les
            imperfections. Particulièrement adapté aux tuiles béton dont la couleur a pâli, pour
            un coup de neuf sans travaux lourds.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Processus d'application ──────────────────────────────── -->
  <section class="section">
    <div class="conteneur">
      <h2>Processus d'application du traitement</h2>
      <div class="etapes">
        <div class="etape">
          <span class="etape__numero">01</span>
          <h3>Diagnostic personnalisé</h3>
          <p>
            J'inspecte votre toiture : type de matériaux, état, porosité et exposition aux
            intempéries. Cette analyse détermine si un traitement est utile et quel produit
            convient à votre situation.
          </p>
        </div>
        <div class="etape">
          <span class="etape__numero">02</span>
          <h3>Préparation de la surface</h3>
          <p>
            La toiture doit être parfaitement propre et sèche : toute humidité résiduelle ou
            présence de mousses compromettrait l'efficacité. Si nécessaire, je programme un
            nettoyage préalable.
          </p>
        </div>
        <div class="etape">
          <span class="etape__numero">03</span>
          <h3>Application contrôlée</h3>
          <p>
            Application au pulvérisateur basse pression, par temps sec et doux (5 à 25 °C), sans
            vent fort ni pluie annoncée sous 24 h, en respectant scrupuleusement les dosages du
            fabricant.
          </p>
        </div>
        <div class="etape">
          <span class="etape__numero">04</span>
          <h3>Séchage et remise des documents</h3>
          <p>
            Je respecte intégralement le temps de séchage requis, puis je vous remets les
            documentations techniques et les conseils d'entretien. Durée type : 1 à 2 jours selon
            la surface.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Produits utilisés ────────────────────────────────────── -->
  <section class="section section--gris">
    <div class="conteneur">
      <h2>Mes fournisseurs de traitements pour votre toiture</h2>
      <p>
        J'utilise des traitements professionnels de haute qualité, bien supérieurs aux produits
        grand public, sélectionnés chez des fabricants spécialisés comme
        <a href="https://www.dalep.net/" rel="noopener" target="_blank">Dalep</a> et
        <a href="https://algimouss.com/" rel="noopener" target="_blank">Algimouss</a>. Appliqués
        dans les règles de l'art, ils offrent une protection efficace de 8 à 10 ans.
      </p>
    </div>
  </section>

  <!-- ── FAQ ──────────────────────────────────────────────────── -->
  <section class="section">
    <div class="conteneur">
      <h2>Vos questions sur le traitement de toiture</h2>
      <div class="faq">
        {faq.map((f) => (
          <article class="faq__item">
            <h3>{f.q}</h3>
            <p>{f.r}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaDevis />
</BaseLayout>

<style>
  .faq { max-width: 820px; margin: 2.5rem auto 0; display: grid; gap: 1.25rem; }
  .faq__item {
    background: var(--blanc);
    border: 1px solid var(--gris-200);
    border-radius: var(--rayon);
    padding: 1.4rem 1.6rem;
  }
  .faq__item h3 { margin-bottom: 0.6rem; }
  .faq__item p { margin: 0; color: var(--gris-700); }
</style>
