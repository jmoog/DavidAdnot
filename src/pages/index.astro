---
import BaseLayout from '../layouts/BaseLayout.astro';
import services from '../data/services.json';
import villes from '../data/villes.json';
import AvisCarrousel from '../components/AvisCarrousel.astro';
import CtaDevis from '../components/CtaDevis.astro';
import reviews from '../data/reviews.json';

// La grille met en avant 6 prestations ; nettoyage et traitement ont leur
// section dédiée plus bas. Toutes les pages restent liées au footer.
const servicesGrille = services.filter(
  (s) => !['nettoyage-demoussage-toiture', 'application-de-traitement-de-toiture-dans-les-yvelines-78'].includes(s.slug)
);
---
<BaseLayout
  title="Couvreur 78 Adnot Couvreur Artisan Couvreur Yvelines"
  description="Couvreur 78 Artisan Adnot Couvreur dans les Yvelines. Tous travaux de couverture, nettoyage de toiture 78, rénovation de toiture. Devis travaux de toiture gratuit."
>
  <!-- ── Hero clair, deux colonnes ────────────────────────────── -->
  <section class="hero">
    <div class="conteneur hero__grille">
      <div class="hero__texte">
        <h1>Entreprise de Couverture — Toiture dans les Yvelines (78)</h1>
        <p class="hero__marque">David Adnot</p>
        <p class="hero__google">
          <span class="hero__etoiles" aria-hidden="true">★★★★★</span>
          <strong>{reviews.note.toLocaleString('fr-FR')}/5 sur Google · {reviews.nombre} avis</strong>
        </p>
        <p class="hero__accroche">
          Artisan couvreur de père en fils, installé à <strong>Rambouillet</strong>. J'interviens
          dans les <strong>Yvelines</strong> pour l'entretien, la réparation et la rénovation de
          votre toiture.
        </p>
        <p>
          Je connais parfaitement les matériaux de couverture utilisés dans notre région, que ce
          soit l'ardoise, la tuile ou le zinc. Je maîtrise aussi les contraintes spécifiques du
          <strong>Parc Naturel de la Haute Vallée de Chevreuse</strong> et j'interviens sur les
          toitures typiques des Yvelines. Mon expertise et mon savoir-faire sont à votre service
          pour protéger et valoriser votre patrimoine.
        </p>
        <ul>
          <li>Un <strong>artisan couvreur de père en fils</strong>.</li>
          <li><strong>Garantie décennale</strong> sur l'ensemble de mes travaux.</li>
          <li>Plus de <strong>20 ans d'expérience</strong> sur les toits.</li>
          <li><strong>Devis gratuit</strong> et sans engagement.</li>
        </ul>
        <div class="hero__actions">
          <a href="tel:0660491430" class="btn btn--rouge">
            <svg class="icone" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.25 1z"/></svg>
            06 60 49 14 30
          </a>
          <a href="/contact/" class="btn btn--bleu">Devis Gratuit →</a>
        </div>
      </div>

      <div class="hero__media">
        <img
          class="hero__photo"
          src="/images/equipe/david-adnot-couvreur-rambouillet-09.webp"
          alt="Véhicule David Adnot Artisan Couvreur devant un chantier de toiture dans les Yvelines"
          fetchpriority="high"
          width="1600"
          height="1200"
        />
        <div class="carte hero__garantie">
          <span class="hero__garantie-icone" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5z"/><path d="M8.5 12l2.5 2.5L16 9.5"/></svg>
          </span>
          <p><strong>Garantie Décennale</strong><br />Pour tous travaux de couverture</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Bandeau de réassurance ───────────────────────────────── -->
  <div class="reassurance">
    <ul>
      <li><svg class="icone" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 10.6 4.2 2.4-.8 1.3L11 13V7h2z"/></svg> Intervention rapide, urgences traitées</li>
      <li><svg class="icone" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg> Devis gratuit et sans engagement</li>
      <li><svg class="icone" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5z"/></svg> Garantie décennale</li>
      <li><svg class="icone" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2 2 9h3v11h6v-6h2v6h6V9h3z"/></svg> Artisan de Rambouillet</li>
    </ul>
  </div>

  <!-- ── Avis clients (carrousel) ─────────────────────────────── -->
  <AvisCarrousel />

  <!-- ── CTA devis (photo + panneau bleu) ─────────────────────── -->
  <CtaDevis />

  <!-- ── Services ─────────────────────────────────────────────── -->
  <section class="section section--gris">
    <div class="conteneur">
      <h2>Mon savoir-faire d'Artisan Couvreur dans les Yvelines (78)</h2>
      <div class="grille-services">
        {servicesGrille.map((s) => (
          <a href={`/${s.slug}/`} class="carte carte-service">
            <img src={s.image} alt={s.alt} loading="lazy" width="400" height="250" />
            <span class="carte-service__corps">
              <h3>{s.label}</h3>
              <p>{s.accroche}</p>
              <span class="carte-service__lien">{s.lien} →</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Nettoyage, démoussage & traitement ───────────────────── -->
  <section class="section">
    <div class="conteneur">
      <div class="section__entete section__entete--gauche">
        <h2>Nettoyage, démoussage et traitement de toiture</h2>
      </div>
    </div>
    <div class="conteneur duo">
      <div>
        <p>
          La proximité des forêts et des points d'eau de la vallée de Chevreuse crée un
          environnement humide particulièrement favorable au développement des mousses et
          lichens. J'assure le <a href="/nettoyage-demoussage-toiture/">nettoyage et le
          démoussage de votre toiture</a> en tuile ou en ardoise pour éliminer les dépôts
          végétaux et préserver l'étanchéité de votre couverture.
        </p>
        <h3>Nettoyage et démoussage</h3>
        <p>
          Brossage manuel, lavage doux à basse pression et élimination des mousses : je redonne
          à votre toiture son aspect et ses performances d'origine, avec des techniques adaptées
          à chaque matériau.
        </p>
        <h3>Traitements hydrofuges et anti-mousse</h3>
        <p>
          Après le nettoyage, j'applique des <a href="/application-de-traitement-de-toiture-dans-les-yvelines-78/">traitements
          hydrofuges et anti-mousse professionnels</a> qui imperméabilisent les matériaux,
          empêchent la repousse des végétaux et prolongent la vie de votre toit.
        </p>
        <a href="/nettoyage-demoussage-toiture/" class="btn btn--bleu">Nettoyer et démousser mon toit</a>
      </div>
      <img
        src="/images/nettoyage/nettoyage-demoussage-toiture-yvelines-02.webp"
        alt="Toiture en tuiles avant et après démoussage dans les Yvelines"
        loading="lazy"
        width="1200"
        height="900"
      />
    </div>
  </section>

  <!-- ── Savoir-faire couvreur-zingueur ───────────────────────── -->
  <section class="section section--bleute">
    <div class="conteneur">
      <div class="section__entete section__entete--gauche">
        <h2>Un couvreur-zingueur avec une solide expérience pour tous vos travaux</h2>
      </div>
    </div>
    <div class="conteneur duo duo--inverse">
      <div>
        <p>
          On ne s'improvise pas artisan couvreur. Ce métier demande une maîtrise technique
          patiemment acquise et une connaissance approfondie des matériaux. Héritier d'un
          savoir-faire familial transmis de génération en génération, je perpétue cette exigence
          du travail bien fait sur chaque chantier, des Yvelines à l'Eure-et-Loir.
        </p>
        <p>
          Mon intervention allie le respect des règles de l'art — que ce soit pour la pose
          d'ardoise, la soudure du zinc ou la pose de tuiles — à une écoute constante de vos
          attentes. Chaque toiture est unique : mon rôle est de la
          <a href="/renovation-toiture/">rénover</a> ou de la
          <a href="/reparation-toiture/">réparer</a> en préservant son intégrité, avec des
          matériaux sélectionnés pour leur fiabilité et leur longévité.
        </p>
        <p>
          Cette démarche rigoureuse, où l'expertise de l'artisan rencontre les besoins du
          client, est le gage d'un résultat durable et esthétique.
        </p>
        <a href="/renovation-toiture/" class="btn btn--bleu">Rénover ou remplacer ma toiture</a>
      </div>
      <img
        src="/images/renovation/renovation-de-toiture-yvelines-04.webp"
        alt="Rénovation de toiture en tuiles sur échafaudage dans les Yvelines"
        loading="lazy"
        width="1200"
        height="900"
      />
    </div>
  </section>

  <!-- ── Pourquoi nous choisir ────────────────────────────────── -->
  <section class="section section--bleu pourquoi">
    <div class="conteneur">
      <h2>Pourquoi confier votre toiture à David Adnot ?</h2>
      <div class="etapes">
        <div class="etape">
          <span class="etape__numero">01</span>
          <h3>Un artisan d'ici, qui connaît vos toits</h3>
          <p>
            Installé à Rambouillet, je connais les toitures de la région et les contraintes du
            Parc Naturel de la Haute Vallée de Chevreuse. J'interviens rapidement dans tout le
            sud des Yvelines.
          </p>
        </div>
        <div class="etape">
          <span class="etape__numero">02</span>
          <h3>Garantie décennale et savoir-faire familial</h3>
          <p>
            Couvreur de père en fils, avec plus de 20 ans d'expérience, je couvre l'ensemble de
            mes travaux par une garantie décennale, pour votre tranquillité.
          </p>
        </div>
        <div class="etape">
          <span class="etape__numero">03</span>
          <h3>Devis détaillé, gratuit et sans engagement</h3>
          <p>
            J'évalue votre besoin sur place et vous remets un devis clair, détaillé et gratuit.
            Paiement en 3 ou 4 fois possible pour faire face plus facilement à un imprévu.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Étapes de la réfection ───────────────────────────────── -->
  <section class="section">
    <div class="conteneur">
      <h2>Refaire votre toiture : les étapes de la réfection</h2>
      <p style="max-width: 70ch; margin-inline: auto; text-align: center;">
        Un projet de réfection de toiture suit un processus structuré. Voici les étapes clés que
        je respecte pour garantir la conformité et la pérennité des travaux.
      </p>
      <div class="etapes">
        <div class="etape">
          <span class="etape__numero">01</span>
          <h3>Démarches administratives</h3>
          <p>
            Dans le périmètre du Parc Naturel de la Haute Vallée de Chevreuse, une déclaration
            préalable de travaux est souvent exigée. Je vous fournis les éléments techniques
            nécessaires à votre dossier.
          </p>
        </div>
        <div class="etape">
          <span class="etape__numero">02</span>
          <h3>Diagnostic et devis détaillé</h3>
          <p>
            J'inspecte la charpente et la couverture, puis j'établis un devis qui liste les
            prestations, les matériaux sélectionnés et le phasage des opérations.
          </p>
        </div>
        <div class="etape">
          <span class="etape__numero">03</span>
          <h3>Dépose et mise en œuvre</h3>
          <p>
            Sécurisation du chantier, dépose de l'ancienne couverture, écran de sous-toiture,
            ventilation conforme aux DTU puis pose du matériau retenu : tuile, ardoise ou zinc.
          </p>
        </div>
        <div class="etape">
          <span class="etape__numero">04</span>
          <h3>Zinguerie, finitions et réception</h3>
          <p>
            Gouttières, chéneaux, faîtages et solins assurent l'étanchéité des jonctions. Le
            chantier est nettoyé et une visite de réception valide la conformité des travaux.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Fournisseurs ─────────────────────────────────────────── -->
  <section class="section section--gris fournisseurs">
    <div class="conteneur">
      <h2>Mes fournisseurs de matériaux</h2>
      <ul class="fournisseurs__grille">
        <li>
          <a href="https://www.dalep.net/" class="carte fournisseurs__carte" rel="noopener" target="_blank">
            <img src="/images/fournisseurs/logo-dalep.webp" alt="Dalep – traitements professionnels pour toitures" loading="lazy" height="56" />
            <span>dalep.net</span>
          </a>
        </li>
        <li>
          <a href="https://www.pointp.fr/" class="carte fournisseurs__carte" rel="noopener" target="_blank">
            <img src="/images/fournisseurs/logo-point-p.webp" alt="Point P – distributeur de matériaux de couverture" loading="lazy" height="56" />
            <span>pointp.fr</span>
          </a>
        </li>
        <li>
          <a href="https://www.bmigroup.com/fr/tuiles-terre-cuite/" class="carte fournisseurs__carte" rel="noopener" target="_blank">
            <img src="/images/fournisseurs/logo-monier.webp" alt="BMI Monier – tuiles en terre cuite" loading="lazy" height="56" />
            <span>bmigroup.com</span>
          </a>
        </li>
        <li>
          <a href="https://www.velux.fr/" class="carte fournisseurs__carte" rel="noopener" target="_blank">
            <img src="/images/fournisseurs/logo-velux.webp" alt="Velux – fenêtres de toit" loading="lazy" height="56" />
            <span>velux.fr</span>
          </a>
        </li>
        <li>
          <a href="https://www.prefa.fr/" class="carte fournisseurs__carte" rel="noopener" target="_blank">
            <img src="/images/fournisseurs/logo-prefa.webp" alt="Prefa – couverture et façade en aluminium" loading="lazy" height="56" />
            <span>prefa.fr</span>
          </a>
        </li>
        <li>
          <a href="https://www.vinylit.de/fr/" class="carte fournisseurs__carte" rel="noopener" target="_blank">
            <img src="/images/fournisseurs/logo-vinylit.webp" alt="Vinylit – bardage et habillage de façade" loading="lazy" height="56" />
            <span>vinylit.de</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- ── Zone d'intervention ──────────────────────────────────── -->
  <section class="section">
    <div class="conteneur">
      <h2>Votre couvreur à Rambouillet et dans le sud des Yvelines</h2>
      <p>
        Basé à Rambouillet, j'interviens dans tout le sud des Yvelines et les communes
        limitrophes. Trouvez votre commune :
      </p>
      <ul class="nuage-villes">
        {villes.map((v) => (
          <li><a href={`/couvreur-a-${v.slug}/`}>{v.nom}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── CTA final ────────────────────────────────────────────── -->
  <section class="section section--bleu cta-final">
    <div class="conteneur">
      <h2>Obtenez un devis pour refaire votre toiture dans les Yvelines</h2>
      <p>
        Besoin de refaire votre toiture ? Faites confiance à mon expertise d'artisan couvreur
        pour un devis gratuit et personnalisé. Contactez-moi dès aujourd'hui pour transformer
        votre projet.
      </p>
      <div class="cta-final__actions">
        <a href="tel:0660491430" class="btn btn--rouge">
          <svg class="icone" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .57 3.6 1 1 0 0 1-.25 1z"/></svg>
          06 60 49 14 30
        </a>
        <a href="/contact/" class="btn btn--blanc">Formulaire de devis</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero__garantie-icone {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--rouge-pale);
    color: var(--rouge);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .hero__garantie-icone svg { width: 2.1rem; height: 2.1rem; }
</style>
