---
<BaseLayout title={title} description={description}>
  <section class="section">
    <div class="conteneur prose">
      <FilAriane items={[{ label: 'Accueil', href: '/' }, { label: 'Mentions légales' }]} />
      <h1>Mentions légales Couvreur 78</h1>
      <p><em>Dernière mise à jour : 24 août 2025</em></p>

