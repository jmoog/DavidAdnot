---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroPage from '../components/HeroPage.astro';
import AvisCarrousel from '../components/AvisCarrousel.astro';
import CtaDevis from '../components/CtaDevis.astro';

const title = 'Nettoyage & Démoussage Toiture M. Adnot - Expert Toiture 78';
const description = 'David Adnot nettoie et démousse votre toiture dans les Yvelines. Intervention professionnelle pour une toiture propre. Devis gratuit.';

// FAQ (données structurées FAQPage) — reprise du contenu éditorial du site
const faq = [
  {
    q: 'Pourquoi nettoyer ma toiture ?',
    r: "Une toiture encrassée par les mousses, lichens et dépôts végétaux perd progressivement son étanchéité et son efficacité. Ces éléments retiennent l'humidité contre les matériaux, ce qui peut entraîner des dégradations prématurées (microfissures, porosité). Un nettoyage professionnel redonne à votre couverture ses capacités de protection et son aspect esthétique originel.",
  },
  {
    q: 'Pourquoi faire appel à un professionnel plutôt que de le faire soi-même ?',
    r: "Le nettoyage de toiture comporte des risques importants (chutes, dommages aux matériaux) et nécessite un matériel spécifique : nettoyeur professionnel, équipements de sécurité, système de récupération des eaux. Mon expertise me permet d'adapter la technique et la pression de nettoyage à chaque type de matériau (tuile, ardoise), sans les endommager. Je garantis également l'évacuation conforme des déchets et des eaux usées.",
  },
  {
    q: 'Quelles techniques utilisez-vous pour ne pas abîmer les matériaux ?',
    r: "J'utilise principalement le brossage manuel et le lavage doux à basse pression (30-60 bars), parfaitement adaptés aux toitures en tuile et ardoise. La haute pression (100 bars maximum) n'est employée qu'exceptionnellement sur des matériaux très résistants, en contrôlant rigoureusement la distance et l'angle d'application pour éviter tout dommage.",
  },
  {
    q: 'Proposez-vous un traitement après le nettoyage pour ralentir la repousse des mousses ?',
    r: "Oui, je propose en option l'application d'un traitement hydrofuge et anti-mousse après le nettoyage. Ce produit professionnel permet de ralentir significativement la repousse des végétaux et améliore l'étanchéité des matériaux.",
  },
  {
    q: "Quel est le tarif d'un nettoyage de toiture ?",
    r: "Le coût dépend de plusieurs facteurs : la surface et la pente de la toiture, le type de matériau et l'importance des dépôts à éliminer. Je propose systématiquement un devis gratuit et personnalisé après une visite, afin de vous transmettre un prix exact et transparent.",
  },
];

const extraSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Nettoyage et démoussage de toiture',
    serviceType: 'Nettoyage de toiture',
    provider: { '@id': 'https://www.adnot-couvreur.fr/#localbusiness' },
    areaServed: { '@type': 'AdministrativeArea', name: 'Yvelines (78) — Rambouillet' },
    url: 'https://www.adnot-couvreur.fr/nettoyage-demoussage-toiture/',
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.r },
    })),
  },
];
---
<BaseLayout title={title} description={description} extraSchemas={extraSchemas}>
  <HeroPage
    h1="Nettoyage et démoussage de toiture dans les Yvelines (78)"
    image="/images/nettoyage/nettoyage-demoussage-toiture-yvelines-01.webp"
    imageAlt="Nettoyage et démoussage d'une toiture en tuiles dans les Yvelines : avant / après"
    ariane="Nettoyage et démoussage de toiture"
  >
    <p class="hero__accroche">
      Artisan couvreur installé à Rambouillet, je suis spécialiste du nettoyage et du démoussage
      des toitures dans les <a href="/">Yvelines</a>.
    </p>
    <p>
      La proximité des forêts et des points d'eau de la vallée de Chevreuse crée un environnement
      humide particulièrement favorable au développement des mousses et lichens sur les toitures.
      Cette végétation, si elle n'est pas éliminée, retient l'humidité contre les matériaux et
      accélère leur dégradation.
    </p>
    <ul>
      <li><strong>Brossage manuel</strong> adapté à chaque matériau, tuile ou ardoise.</li>
      <li><strong>Lavage doux à basse pression</strong> (30 à 60 bars) au matériel professionnel.</li>
      <li><strong>Traitement hydrofuge et anti-mousse</strong> en option pour protéger durablement.</li>
    </ul>
  </HeroPage>

  <!-- ── Avis clients (ceux qui parlent de nettoyage en premier) ── -->
  <AvisCarrousel tag="nettoyage" />

  <!-- ── Techniques de nettoyage ──────────────────────────────── -->
  <section class="section">
    <div class="conteneur">
      <div class="section__entete section__entete--gauche">
        <h2>Différentes techniques pour bien laver votre toiture</h2>
      </div>
    </div>
    <div class="conteneur duo">
      <div>
        <h3>Nettoyage par brossage manuel</h3>
        <p>
          Le brossage manuel constitue la méthode fondamentale pour éliminer les dépôts végétaux
          incrustés. J'utilise des brosses spécifiques — nylon souple pour les ardoises
          naturelles, fibres plus rigides pour les tuiles en béton — permettant de décoller les
          mousses et lichens sans rayer les surfaces. L'intervention s'effectue toujours selon le
          sens de pose des éléments pour ne pas désorganiser leur agencement.
        </p>
        <p>
          Cette méthode permet un contrôle total sur chaque centimètre carré de la couverture,
          notamment dans les zones délicates comme les arêtiers ou les noues. Le brossage manuel
          préserve l'intégrité des matériaux anciens ou fragiles et reste indispensable avant
          toute intervention mécanisée.
        </p>
      </div>
      <img
        src="/images/nettoyage/nettoyage-demoussage-toiture-yvelines-08.webp"
        alt="Brossage et nettoyage d'une toiture en tuiles dans les Yvelines"
        loading="lazy"
        width="1200"
        height="800"
      />
    </div>
  </section>

  <!-- ── Basse pression / haute pression ──────────────────────── -->
  <section class="section section--bleute">
    <div class="conteneur duo duo--inverse">
      <div>
        <h2>Lavage doux à basse pression, haute pression maîtrisée</h2>
        <p>
          Le lavage à basse pression représente la solution professionnelle pour le rinçage
          approfondi des toitures. Contrairement aux nettoyeurs haute pression grand public,
          j'utilise un matériel qui permet de réguler précisément le débit et la pression entre
          <strong>30 et 60 bars</strong> : les résidus sont éliminés après brossage sans forcer
          l'eau sous les tuiles ni déjointoyer les ardoises.
        </p>
        <p>
          Dans certains cas spécifiques — tuiles en béton très encrassées — une haute pression
          maîtrisée peut s'avérer nécessaire. Elle est rigoureusement limitée à
          <strong>100 bars maximum</strong>, avec une distance de sécurité et un angle de
          projection adaptés, et n'est envisagée qu'après une inspection minutieuse de l'état de
          la couverture.
        </p>
        <a href="/contact/" class="btn btn--bleu">Demander le nettoyage de mon toit</a>
      </div>
      <img
        src="/images/nettoyage/nettoyage-demoussage-toiture-yvelines-16.webp"
        alt="Lavage basse pression d'une toiture en tuiles par David Adnot"
        loading="lazy"
        width="1200"
        height="900"
      />
    </div>
  </section>

  <!-- ── Processus d'intervention ─────────────────────────────── -->
  <section class="section">
    <div class="conteneur">
      <h2>Processus d'intervention pour le nettoyage de votre toiture</h2>
      <div class="etapes">
        <div class="etape">
          <span class="etape__numero">01</span>
          <h3>Évaluation et devis détaillé</h3>
          <p>
            Je me déplace à votre domicile pour un diagnostic complet : type de matériau, pente,
            ampleur des dépôts végétaux et accessibilité. Vous recevez un devis transparent qui
            détaille prestations, techniques employées et temps d'intervention.
          </p>
        </div>
        <div class="etape">
          <span class="etape__numero">02</span>
          <h3>Préparation et sécurisation</h3>
          <p>
            Installation d'un échafaudage stable, protection de vos espaces extérieurs (massifs,
            terrasses, mobilier) à l'aide de bâches. Le chantier se déroule dans des conditions
            optimales de sécurité et de propreté.
          </p>
        </div>
        <div class="etape">
          <span class="etape__numero">03</span>
          <h3>Réalisation du nettoyage</h3>
          <p>
            Brossage manuel minutieux, puis lavage doux à basse pression selon les besoins
            identifiés lors du diagnostic. Les gouttières et descentes d'eau pluviale sont
            également nettoyées.
          </p>
        </div>
        <div class="etape">
          <span class="etape__numero">04</span>
          <h3>Évacuation et réception</h3>
          <p>
            Les déchets végétaux et eaux usées sont récupérés conformément à la réglementation.
            Une visite de réception valide le résultat, avec des conseils personnalisés pour
            prolonger les effets du nettoyage.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Lien traitement ──────────────────────────────────────── -->
  <section class="section section--gris">
    <div class="conteneur">
      <h2>Et après le nettoyage ? Protégez votre toiture</h2>
      <p>
        Pour empêcher la mousse de revenir rapidement, je propose
        l'<a href="/application-de-traitement-de-toiture-dans-les-yvelines-78/">application d'un
        traitement hydrofuge et anti-mousse professionnel</a> une fois la toiture propre et
        sèche. L'eau perle et s'écoule au lieu de pénétrer dans la porosité du matériau : la
        couverture sèche plus vite, résiste mieux au gel et reste propre plusieurs années.
      </p>
    </div>
  </section>

  <!-- ── FAQ ──────────────────────────────────────────────────── -->
  <section class="section">
    <div class="conteneur">
      <h2>Vos questions sur le nettoyage de toiture</h2>
      <div class="faq">
        {faq.map((f) => (
          <article class="faq__item">
            <h3>{f.q}</h3>
            <p>{f.r}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA devis ────────────────────────────────────────────── -->
  <CtaDevis />
</BaseLayout>

<style>
  .faq { max-width: 820px; margin: 2.5rem auto 0; display: grid; gap: 1.25rem; }
  .faq__item {
    background: var(--blanc);
    border: 1px solid var(--gris-200);
    border-radius: var(--rayon);
    padding: 1.4rem 1.6rem;
  }
  .faq__item h3 { margin-bottom: 0.6rem; }
  .faq__item p { margin: 0; color: var(--gris-700); }
</style>
